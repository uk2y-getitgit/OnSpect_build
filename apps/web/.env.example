# Supabase 연결 정보 (Phase 5 트랙1 — 팀 동기화 서버)
#
# VITE_ 접두어가 붙은 값은 빌드 시 클라이언트 번들에 그대로 노출된다 — "publishable" 키만
# 여기 둔다. service_role 키는 절대 이 파일이나 apps/web 쪽에 두지 않는다 —
# 서버리스 함수(apps/web/api/*)에서만 Vercel 환경변수로 읽는다(스펙 §3-6 S5, 검수 규칙).
#
# 실제 값은 .env.local 에 넣는다(.gitignore 대상) — 이 파일은 템플릿일 뿐이다.

VITE_SUPABASE_URL=https://jaglifijobsjugmsnuvl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
