# Supabase 연결 정보 (Phase 5 트랙1 — 팀 동기화 서버)
#
# VITE_ 접두어가 붙은 값은 빌드 시 클라이언트 번들에 그대로 노출된다 — "publishable" 키만
# 여기 둔다.
#
# ⭐ D39·D40 — 이 라운드에는 **서버리스 함수가 하나도 없다.** 클라이언트가 publishable 키 +
#    로그인 사용자의 JWT 로 Supabase 를 직접 호출하고, 팀 격리는 RLS(`my_team_id()`)가 강제한다.
#    `SUPABASE_SERVICE_ROLE_KEY` 는 이 저장소 어디에도 두지 않는다 — 다음 "정식 서버" 라운드에서
#    팀원 발급 API 를 만들 때 처음 등장한다.
#
# 실제 값은 .env.local 에 넣는다(.gitignore 대상) — 이 파일은 템플릿일 뿐이다.
# 값이 없거나 아래 템플릿 그대로면 로그인 게이트도 [동기화] 버튼도 뜨지 않는다 —
# 앱은 지금까지처럼 완전히 로컬로 동작한다.

VITE_SUPABASE_URL=https://jaglifijobsjugmsnuvl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
